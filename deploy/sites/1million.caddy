1million.siphion.dev {
	tls /usr/local/etc/letsencrypt/certificates/siphion.dev.crt /usr/local/etc/letsencrypt/certificates/siphion.dev.key

	route /auth* {
		authenticate with 1million_portal
	}

	# Backend API & health — proxy to backend container
	route /api/* {
		authorize with 1million_policy
		reverse_proxy 127.0.0.1:8888
	}
	route /health {
		authorize with 1million_policy
		reverse_proxy 127.0.0.1:8888
	}

	# Frontend — proxy to Next.js container
	route /* {
		authorize with 1million_policy
		reverse_proxy 127.0.0.1:8887
	}
}
