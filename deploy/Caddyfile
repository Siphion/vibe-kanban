{
	order authenticate before respond
	order authorize before basicauth

	security {
		local identity store localdb {
			realm local
			path {$HOME}/.local/caddy/users.json
		}

		authentication portal vk_portal {
			crypto default token lifetime 86400
			crypto key sign-verify {$JWT_SHARED_KEY}
			enable identity store localdb
			cookie domain vk.siphion.dev
			cookie lifetime 86400
			ui {
				links {
					"Vibe Kanban" https://vk.siphion.dev/ icon "las la-columns"
				}
			}
			transform user {
				match origin local
				action add role authp/user
			}
		}

		authentication portal code_portal {
			crypto default token lifetime 86400
			crypto key sign-verify {$JWT_SHARED_KEY}
			enable identity store localdb
			cookie domain code.siphion.dev
			cookie lifetime 86400
			ui {
				links {
					"Code Server" https://code.siphion.dev/ icon "las la-code"
				}
			}
			transform user {
				match origin local
				action add role authp/user
			}
		}

		authentication portal 1million_portal {
			crypto default token lifetime 86400
			crypto key sign-verify {$JWT_SHARED_KEY}
			enable identity store localdb
			cookie domain 1million.siphion.dev
			cookie lifetime 86400
			ui {
				links {
					"1Million" https://1million.siphion.dev/ icon "las la-chart-line"
				}
			}
			transform user {
				match origin local
				action add role authp/user
			}
		}

		authorization policy mypolicy {
			set auth url https://{$TS_HOSTNAME}/auth/
			allow roles authp/admin authp/user
			crypto key verify {$JWT_SHARED_KEY}
		}

		authorization policy codepolicy {
			set auth url https://code.siphion.dev/auth/
			allow roles authp/admin authp/user
			crypto key verify {$JWT_SHARED_KEY}
		}

		authorization policy 1million_policy {
			set auth url https://1million.siphion.dev/auth/
			allow roles authp/admin authp/user
			crypto key verify {$JWT_SHARED_KEY}
		}

	}
}

vk.siphion.dev {
	tls /usr/local/etc/letsencrypt/certificates/siphion.dev.crt /usr/local/etc/letsencrypt/certificates/siphion.dev.key

	route /auth* {
		authenticate with vk_portal
	}

	# Teams Bot webhook — no auth required (validated by Bot Framework JWT)
	route /api/teams/webhook {
		reverse_proxy 127.0.0.1:38100
	}

	# Preview proxy for iframe content (path-based routing for remote access)
	route /_vk_preview/* {
		authorize with mypolicy
		reverse_proxy 127.0.0.1:{$PREVIEW_PROXY_PORT:38101}
	}

	route /* {
		authorize with mypolicy
		reverse_proxy 127.0.0.1:38100
	}
}

import sites/*.caddy

code.siphion.dev {
	tls /usr/local/etc/letsencrypt/certificates/siphion.dev.crt /usr/local/etc/letsencrypt/certificates/siphion.dev.key

	route /auth* {
		authenticate with code_portal
	}

	route /* {
		authorize with codepolicy
		reverse_proxy 127.0.0.1:38200
	}
}
